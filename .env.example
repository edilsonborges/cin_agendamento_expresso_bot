# =============================================================================
# cin_agendamento_expresso_bot — exemplo de configuração
# Copie para .env (nunca versionado) e preencha.
#
# REGRA DE OURO: a chave do bot Telegram fica APENAS no .env local.
# Nunca colar em PRD, README, comentário, mensagem de commit, screenshot, etc.
# Se vazar, revogar imediatamente via @BotFather (/revoke).
# =============================================================================

# ----- Obrigatórias (preencher no .env, mantém placeholder aqui) -----
TELEGRAM_BOT_TOKEN=<obtenha-em-@BotFather>
TELEGRAM_CHAT_ID=<obtido-via-python-m-bot-init>

# ----- Opcionais (com defaults aplicados se vazio) -----
POLL_INTERVAL_SECONDS=180
JITTER_SECONDS=30
COD_MUNICIPIO=25300
ID_SENHA=58
LOG_LEVEL=INFO

# ----- Credenciais Goiás Digital (públicas, capturadas do front-end) -----
# Esta credencial é o client_credentials público do Goiás Digital — qualquer
# pessoa que abrir o DevTools no portal vê os mesmos valores. Por isso é OK
# manter aqui no .env.example. Trocar SOMENTE se o portal renovar o client.
# Para capturar valor atual: DevTools > Network > requisição POST para
# https://api.go.gov.br/token > header Authorization: Basic <este-valor>.
GOIAS_OAUTH_BASIC=<basic-base64-capturado-do-front>
GOIAS_REFERER=https://www.go.gov.br/servicos-digitais/vapt-vupt/agendamento-atendimento-presencial/novo/origem-rg
